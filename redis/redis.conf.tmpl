# =============================================================================
# Redis forensic-readiness configuration
#
# Placeholders substituted by cloud-init on first boot:
#   __BIND_IP__ to the VM's private IP address
#
#   - verbose server logging
#   - AOF + RDB persistence preserved
#   - ACL enforcement, through users.acl, for attribution via ACL LOG
# =============================================================================

# --- Network -----------------------------------------------------------------
# Bind to loopback + the private VNet IP only. Redis is NOT exposed publicly;
# the NSG additionally restricts 6379 to the VNet.
bind 127.0.0.1 __BIND_IP__
port 6379
protected-mode yes

# --- Process supervision -----------------------------------------------------
# The packaged systemd unit is Type=notify; Redis must tell systemd it is ready,
# otherwise systemd times out the start and kills/restarts Redis in a loop.
supervised systemd

# --- Security / ACL ----------------------------------------------------------
# User definitions live in a dedicated ACL file (reader / writer / admin).
aclfile /etc/redis/users.acl

# --- Logging (Section VI: high-verbosity server logging) ---------------------
loglevel verbose
logfile /var/log/redis/redis-server.log

# --- RDB persistence ---------------------------------------------------------
# Save a point-in-time snapshot on these thresholds; also triggerable via SAVE/BGSAVE.
# Production thresholds:
# save 900 1
# save 300 10
# save 60 10000
# Test:
save 3 1
dbfilename dump.rdb
dir /var/lib/redis

# --- AOF persistence ---------------------------------------------------------
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec
