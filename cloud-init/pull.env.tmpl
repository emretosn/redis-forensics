# pull.env — runtime configuration for the forensics-vm evidence pull.
# The collector reaches redis-vm over the peered VNet on its private IP and pulls
# read-only via a dedicated key. Placeholders (__*__) are substituted by main.bicep.
SOURCE_USER=evidence
SOURCE_HOST=__REDIS_HOST__
PULL_KEY=/etc/redis-forensics/pull_key

# Immutable evidence store and mutable state cache (last-snapshot hashes).
STORE_DIR=/var/forensics-store/redis-vm
STATE_DIR=/var/lib/forensic-pull
