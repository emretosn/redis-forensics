# forensics.env — runtime configuration for redis-vm LOCAL forensic scripts.
# The pull model means this host holds NO collector credentials. Placeholders
# (__*__) are substituted by main.bicep at deploy time.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ADMIN_USER=admin
ADMIN_PASS=__ADMIN_PASS__

FORENSICS_DIR=/var/forensics
REDIS_DATA_DIR=/var/lib/redis
REDIS_LOG_DIR=/var/log/redis

# Restricted group whose only member is the read-only `evidence` pull user.
EVIDENCE_GROUP=evidence
