# forensics.env — runtime configuration for redis-vm forensic scripts.
# Placeholders (__*__) are substituted by main.bicep at deploy time.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ADMIN_USER=admin
ADMIN_PASS=__ADMIN_PASS__

FORENSICS_DIR=/var/forensics
REDIS_DATA_DIR=/var/lib/redis
REDIS_LOG_DIR=/var/log/redis

COLLECTOR_USER=collector
COLLECTOR_HOST=__COLLECTOR_HOST__
COLLECTOR_DEST=/var/forensics-store
COLLECTOR_KEY=/etc/redis-forensics/collector_key
